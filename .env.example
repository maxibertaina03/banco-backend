PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banco


# Conexión a Postgres.
# - Para la APP: en Supabase podés usar el pooler de transacciones (puerto 6543).
# - Para MIGRAR con Prisma (prisma migrate / baseline): usá la conexión DIRECTA
#   (puerto 5432). El pooler de transacciones no soporta migraciones.
#   En Supabase: Project Settings → Database → Connection string → "Direct connection".
DATABASE_URL=postgresql://usuario:password@localhost:5432/banco

CLERK_SECRET_KEY=sk_test_tu_secret_key_aqui
# Solo backend. Nunca usar VITE_GEMINI_API_KEY ni exponer esta clave al navegador.
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.6-flash
# CORS_ORIGINS: lista separada por comas de orígenes permitidos. Dejar vacío para permitir todos (*).
# CORS_ORIGINS=http://localhost:5173,https://tu-dominio.com
