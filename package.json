{
  "name": "banco-backend",
  "version": "1.0.0",
  "description": "API REST con Express y PostgreSQL para sistema bancario.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/db-setup.js all",
    "db:schema": "node scripts/db-setup.js schema",
    "db:seed": "node scripts/db-setup.js seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "express",
    "postgres",
    "banking",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.1.4",
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@prisma/client": "^5.17.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.17.0",
    "vitest": "^1.6.1"
  }
}
