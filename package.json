{
  "name": "banco-backend",
  "version": "1.0.0",
  "description": "API REST con Express y PostgreSQL para sistema bancario.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/db-setup.js all",
